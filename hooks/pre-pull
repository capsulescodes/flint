unstaged=$( git diff --name-only )

if [[ -n $unstaged ]]

then
    export FLINT_UNSTAGED_FILES=$unstaged
fi

staged=$( git diff --staged --name-only )

if [[ -n $staged ]]

then
    git restore --staged $staged

    export FLINT_STAGED_FILES=$staged
fi

manual=$( git rev-list HEAD --invert-grep --grep='FLINT-TEMPORARY-COMMIT' --max-count=1 )

if [[ -n $manual ]]

then
    git reset --soft $manual --quiet
fi

reset=$( git diff --diff-filter=d --staged --name-only )

if [[ -n $reset ]]

then
    git restore --staged $reset

    eval_for_command "remote" $FLINT_CONFIG "$reset"

    export FLINT_RESET_FILES=$reset
fi
