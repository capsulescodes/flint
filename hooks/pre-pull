manual=$( git rev-list HEAD --invert-grep --grep='FLINT-FIX-TEMP-COMMIT' --max-count=1 )

if [ -n "$manual" ]

then
    git reset --soft $manual --quiet
fi

staged=$( git diff --diff-filter=d --staged --name-only )

if [ -n "$staged" ]

then
    format_for_remote $FLINT_CONFIG "$staged"

    modified=$( git diff --name-only )

    files=()

    while IFS= read -r file

    do
        if [ -n "$file" ] && echo "$modified" | grep -Fqx "$file"

        then
            files+=( $file )
        fi
    done <<< "$staged"


    if [ ${#files[@]} -gt 0 ]

    then
        git add "${files[@]}"
    fi
fi
