if [[ -z $FLINT_TEMPORARY_COMMIT ]]

then
    manual=$( git rev-list HEAD --invert-grep --grep='FLINT-TEMPORARY-COMMIT' --max-count=1 )

    if [[ -n $manual ]]

    then
        git reset --soft $manual --quiet
    fi

    staged=$( git diff --diff-filter=d --staged --name-only )

    if [[ -n $staged ]]

    then
        eval_for_command "remote" $FLINT_CONFIG "$staged"

        modified=$( git diff --diff-filter=d --name-only )

        files=()

        while IFS= read -r file

        do
            if [[ -n $file ]] && echo "$modified" | grep -Fqx "$file"

            then
                files+=( $file )
            fi
        done <<< "$staged"


        if [[ -n ${files[0]} ]]

        then
            git add "${files[@]}"
        fi

        export FLINT_STAGED_FILES=$staged
    fi
fi
