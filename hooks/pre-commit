
if [[ -z "$FLINT_TEMPORARY_COMMIT" ]]

then
    unstaged=$( git diff --name-only )

    staged=$( git diff --staged --name-only )

    patched=()

    while IFS= read -r file

    do
        if [[ -n "$file" ]] && echo "$unstaged" | grep -Fqx "$file"

        then
            patched+=( "$file" )
        fi

    done <<< "$staged"


    if [[ -n "${patched[0]}" ]]

    then
        FLINT_PATCH=$( git diff "${patched[@]}" | git hash-object -w --stdin )

        git stash push --keep-index --quiet -- "${patched[@]}"

        export FLINT_PATCH
    fi




    manual=$( git rev-list HEAD --invert-grep --grep='FLINT-TEMPORARY-COMMIT' --max-count=1 )

    if [[ -n "$manual" ]]

    then
        git reset --soft "$manual" --quiet
    fi




    reset=$( git diff --diff-filter=d --staged --name-only )

    if [[ -n "$reset" ]]

    then
        eval_for_command "remote" "$FLINT_CONFIG" "$reset"

        modified=$( git diff --diff-filter=d --name-only )

        files=()

        while IFS= read -r file

        do
            if [[ -n "$file" ]] && echo "$modified" | grep -Fqx "$file"

            then
                files+=( "$file" )
            fi
        done <<< "$reset"


        if [[ -n "${files[0]}" ]]

        then
            git add "${files[@]}"
        fi

        export FLINT_RESET_FILES="$reset"
    fi
fi
