local pulled=$( git diff --diff-filter=d --name-only @{1} HEAD )

if [ -n "$pulled" ]

then
    local staged=$( git diff --staged --name-only )

    local unstaged=$( git diff --name-only )

    format_for_local $FLINT_CONFIG "$pulled"

    local modified=$( git diff --name-only )

    local before=()

    local after=()

    while IFS= read -r file

    do
        if echo "$modified" | grep -Fqx "$file"

        then
            if ( ! echo "$staged" | grep -Fqx "$file" ) && ( ! echo "$unstaged" | grep -Fqx "$file" )

            then
                before+=( $file )
            fi

            if echo "$staged" | grep -Fqx "$file"

            then
                after+=( $file )
            fi
        fi
    done <<< "$pulled"


    if [ ${#before[@]} -gt 0 ]

    then
        git add "${before[@]}"

        export FLINT_FIX_TEMP_COMMIT=1

        git commit -m "FLINT-FIX-TEMP-COMMIT" --quiet

        unset FLINT_FIX_TEMP_COMMIT
    fi


    if [ ${#after[@]} -gt 0 ]

    then
        git add "${after[@]}"
    fi
fi
