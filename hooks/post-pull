unstaged=$( git diff --name-only )

staged=$( git diff --diff-filter=d --staged --name-only )

pulled=$( git diff --diff-filter=d --name-only @{1} HEAD )

combined=$( ( echo "$unstaged"; echo "$staged"; echo "$pulled" ) | sort | uniq )

if [ -n "$combined" ]

then
    eval_for_local $FLINT_CONFIG "$combined"

    modified=$( git diff --name-only )

    files=()

    while IFS= read -r file

    do
        if [ -n "$file" ] && echo "$modified" | grep -Fqx "$file" && ! echo "$unstaged" | grep -Fqx "$file" && ! echo "$staged" | grep -Fqx "$file"

        then
            files+=( $file )
        fi
    done <<< "$combined"


    if [ ${#files[@]} -gt 0 ]

    then
        git add "${files[@]}"

        [[ -n "$staged" ]] && git restore --staged "$staged"

        export FLINT_FIX_TEMP_COMMIT=1

        git commit -m "FLINT-TEMPORARY-COMMIT" --quiet

        unset FLINT_FIX_TEMP_COMMIT

        [[ -n "$staged" ]] && git add "$staged"
    fi
fi
