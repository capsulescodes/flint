pulled=$( git diff --diff-filter=d --name-only @{1} HEAD 2>/dev/null )

mixed=$( printf "%s\n" $pulled $FLINT_RESET_FILES | sort | uniq )

if [[ -n "$mixed" ]]

then
    eval_for_command "local" "$FLINT_CONFIG" "$mixed"

    modified=$( git diff --diff-filter=d --name-only )

    files=()

    while IFS= read -r file

    do
        if [[ -n "$file" ]] && echo "$modified" | grep -Fqx "$file" && ! echo "$FLINT_UNSTAGED_FILES" | grep -Fqx "$file" && ! echo "$FLINT_STAGED_FILES" | grep -Fqx "$file"

        then
            files+=( "$file" )
        fi
    done <<< "$mixed"


    if [[ -n "${files[0]}" ]]

    then
        git add "${files[@]}"
    fi

    reset=$( git diff --diff-filter=d --staged --name-only )

    if [[ -n "$reset" ]]

    then
        export FLINT_TEMPORARY_COMMIT=1

        git commit -m "FLINT-TEMPORARY-COMMIT" --quiet

        unset FLINT_TEMPORARY_COMMIT
    fi
fi


if [[ -n "$FLINT_RESET_FILES" ]]

then
    unset FLINT_RESET_FILES
fi

if [[ -n "$FLINT_STAGED_FILES" ]]

then
    git add $FLINT_STAGED_FILES

    unset FLINT_STAGED_FILES
fi

if [[ -n "$FLINT_UNSTAGED_FILES" ]]

then
    unset FLINT_UNSTAGED_FILES
fi
