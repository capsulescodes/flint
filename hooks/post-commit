if [[ -z $FLINT_TEMPORARY_COMMIT ]]

then
    committed=$( git diff-tree --diff-filter=d --name-only --no-commit-id -r HEAD )

    combined=$( printf "%s\n%s\n" "$committed" "$FLINT_STAGED_FILES" | sort | uniq )

    if [[ -n $combined ]]

    then
        eval_for_command "local" $FLINT_CONFIG "$combined"

        modified=$( git diff --diff-filter=d --name-only )

        files=()

        while IFS= read -r file

        do
            if [[ -n $file ]] && echo "$modified" | grep -Fqx "$file"

            then
                files+=( $file )
            fi
        done <<< "$combined"


        if [[ -n ${files[0]} ]]

        then
            git add "${files[@]}"
        fi

        reset=$( git diff --staged --name-only )

        if [[ -n $reset ]]

        then
            export FLINT_TEMPORARY_COMMIT=1

            git commit -m "FLINT-TEMPORARY-COMMIT" --quiet

            unset FLINT_TEMPORARY_COMMIT
        fi
    fi
fi

if [[ -n $FLINT_STAGED_FILES ]]

then
    unset FLINT_STAGED_FILES
fi
