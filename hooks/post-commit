if [ -z "$FLINT_FIX_TEMP_COMMIT" ]

then
    committed=$( git diff-tree --no-commit-id --name-only -r HEAD )

    if [ -n "$committed" ]

    then
        format_for_local "$FLINT_CONFIG" "$committed"

        modified=$( git diff --name-only --diff-filter=M )

        files=()

        while IFS= read -r file

        do
            if echo "$modified" | grep -Fqx "$file"

            then
                files+=( "$file" )
            fi
        done <<< "$committed"


        if [ ${#files[@]} -gt 0 ]

        then
            git add "${files[@]}"

            export FLINT_FIX_TEMP_COMMIT=1

            git commit -m "FLINT-FIX-TEMP-COMMIT" --quiet

            unset FLINT_FIX_TEMP_COMMIT
        fi
    fi
fi
