#!/bin/bash

target="$0"


while [ -h "$target" ]

do
    directory="$( cd -P "$( dirname $target )" && pwd )"

    target="$( readlink "$target" )"

    [[ "$target" != /* ]] && target="$directory/$target"
done


path="$( cd -P "$( dirname $target )" && pwd )/../dist"




if [[ $1 == 'init' ]]

then
    sh "$path/init.sh" $@

    exit 0
fi

if [[ $1 == 'run' ]] || [[ -z $1 ]]

then
    sh "$path/run.sh"

    exit 0
fi

if [[ $1 == '-h' ]] || [[ $1 == '--help' ]]

then
    sh "$path/help.sh"

    exit 0
fi


printf "\n\033[1;30m[ Flint ] Command \"$1\" not found. Run \"-h\" or \"--help\" for more options.\033[0m\n\n"
