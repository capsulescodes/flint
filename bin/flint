#!/bin/bash

target=$0


while [[ -h $target ]]

do
    directory="$( cd -P "$( dirname $target )" && pwd )"

    target="$( readlink "$target" )"

    [[ $target != /* ]] && target="$directory/$target"
done


path="$( cd -P "$( dirname $target )" && pwd )/../dist"




if [[ $1 == '-h' || $1 == '--help' ]]

then
    sh "$path/help.sh"

    exit 0
fi

if [[ $1 == '-i' || $1 == '--init' ]]

then
    sh "$path/init.sh" $@

    exit $?
fi

if [[ $1 == '-r' || $1 == '--run' ]]

then
    sh "$path/run.sh" $@

    exit $?
fi




if [[ -f "$PWD/.flint/git.sh" ]]

then
    sh "$PWD/.flint/git.sh" $@
else
    command git $@
fi
